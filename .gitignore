node_modules/
CLAUDE.md
*.db
# Copias de la BD que no terminan en .db: .db-shm, .db-wal, .db.tmp y las
# manuales (.db.bak-*, .db.prerevert-*, .db.backup-*). Sin esto aparecen como
# untracked y con ellas el riesgo de commitear una base entera por error.
*.db.*
*.db-shm
*.db-wal
.env
dist/
backend/uploads/*
!backend/uploads/.gitkeep
backend/backups/*
!backend/backups/.gitkeep
dist2/
dist3/
server.log
precios-importacion/

# Salida generada: lo escribe utilidades/fb-ranking/content_library_views.js al
# correr el POC de forma manual. Es un artefacto de runtime, no fuente.
utilidades/fb-ranking/reporte_POC_fechas.json

# Logs de runtime (cualquier carpeta).
*.log

# Datos de entrenamiento de tesseract (~8.5 MB cada uno); tesseract.js los baja
# y cachea por su cuenta, estas copias locales no van al repo.
*.traineddata

# Scripts de debugging desechables (no deben vivir en el repo: el primero
# fabrica tokens validos leyendo auth_secret de la BD).
backend/_token-tmp.mjs
backend/tmp_find_upload.js
